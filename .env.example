# =============================================================================
# APOLLO Gov Proposal System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See docs/environment_variables.md for detailed descriptions.
# =============================================================================

# --- Required -----------------------------------------------------------

# API key for Subscan (Polkadot chain data)
SUBSCAN_API_KEY=your_subscan_api_key_here

# WebSocket endpoint of the target Substrate node
SUBSTRATE_NODE_URL=wss://rpc.polkadot.io

# --- Optional: Data Sources ---------------------------------------------

# News API key (https://newsapi.org)
NEWS_API_KEY=

# Reddit API credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional: Notifications --------------------------------------------

# Discord webhook for broadcasting updates
DISCORD_WEBHOOK_URL=

# Telegram bot for sending messages
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X/Twitter bearer token for posting summaries
TWITTER_BEARER=

# --- Optional: On-chain ---------------------------------------------------

# sr25519 private key for signing on-chain transactions
SUBSTRATE_PRIVATE_KEY=

# --- Optional: Data Weights (0.0 - 1.0) ---------------------------------

DATA_WEIGHT_CHAT=
DATA_WEIGHT_FORUM=
DATA_WEIGHT_NEWS=
DATA_WEIGHT_CHAIN=
DATA_WEIGHT_GOVERNANCE=

# --- Optional: Analysis Tuning -------------------------------------------

# Number of days of news to collect
NEWS_LOOKBACK_DAYS=

# Seed for deterministic sampling of past referenda
HISTORICAL_SAMPLE_SEED=

# Confidence threshold to classify drafts as likely to pass (0.0 - 1.0)
MIN_PASS_CONFIDENCE=

# --- Optional: EVM Integration -------------------------------------------

# Set to "true" to fetch blocks from an EVM-compatible chain
ENABLE_EVM_FETCH=false

# RPC endpoint (required when ENABLE_EVM_FETCH=true)
EVM_RPC_URL=

# Block range for EVM data collection
EVM_START_BLOCK=
EVM_END_BLOCK=
